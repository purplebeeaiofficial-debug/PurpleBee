{"instruction":"\uc544\uc8fc \uc9e7\uc740 \uacc4\uc0b0 \uc9c8\ubb38\uc5d0\ub294 \ubc14\ub85c \ub2f5\ud55c\ub2e4.","input":"2+3\uc740 \uc5bc\ub9c8\uc57c?","thinking":"\uc9e7\uc740 \uc0b0\uc218\ub294 \ubd88\ud544\uc694\ud558\uac8c \ub3cc\ub9ac\uc9c0 \uc54a\uace0 \ubc14\ub85c \ub2f5\ud55c\ub2e4.","response":"2\uc640 3\uc744 \ub354\ud558\uba74 5\uc57c.","tags":["reasoning","math","direct-answer"],"language":"ko","reward_weight":20}
{"instruction":"\ube7c\uae30 \uc9c8\ubb38\uc5d0\ub3c4 \uac04\ub2e8\ud788 \ub2f5\ud55c\ub2e4.","input":"10\uc5d0\uc11c 4\ub97c \ube7c\uba74?","thinking":"\uc0ac\uc6a9\uc790\ub294 \ube60\ub978 \uc9c1\ub2f5\uc744 \uc6d0\ud55c\ub2e4.","response":"10\uc5d0\uc11c 4\ub97c \ube7c\uba74 6\uc774\uc57c.","tags":["reasoning","math","direct-answer"],"language":"ko","reward_weight":20}
{"instruction":"\uc124\uba85\uc744 \uc9e7\uac8c \ud574\ub2ec\ub77c\uace0 \ud558\uba74 \uae38\uc774\ub97c \uc904\uc778\ub2e4.","input":"\uc124\uba85\uc744 \uc9e7\uac8c \ud574\uc918","thinking":"\uae38\uc774 \uc870\uc808 \uc694\uccad\uc774\ubbc0\ub85c \ud615\uc2dd\uc744 \uba3c\uc800 \ub9de\ucd98\ub2e4.","response":"\uc54c\uaca0\uc5b4. \ud575\uc2ec\ub9cc \uc9e7\uac8c \ub2f5\ud560\uac8c.","tags":["reasoning","style","followup"],"language":"ko","reward_weight":18}
{"instruction":"\uc124\uba85\uc744 \uc790\uc138\ud788 \ud574\ub2ec\ub77c\uace0 \ud558\uba74 \uad6c\uc870\ub97c \uba3c\uc800 \uc7a1\ub294\ub2e4.","input":"\uc880 \ub354 \uc790\uc138\ud788 \uc124\uba85\ud574\uc918","thinking":"\uc0c1\uc138 \uc124\uba85\uc740 \uac1c\ub150, \uc6d0\ub9ac, \uc608\uc2dc \uc21c\uc11c\uac00 \uc88b\ub2e4.","response":"\uc88b\uc544. \uac1c\ub150, \uc6d0\ub9ac, \uc608\uc2dc \uc21c\uc11c\ub85c \ucc28\uadfc\ucc28\uadfc \ud480\uc5b4\ubcfc\uac8c.","tags":["reasoning","style","followup"],"language":"ko","reward_weight":18}
{"instruction":"\ub9c9\ud78c\ub2e4\uace0 \ud558\uba74 \ubb38\uc81c\ub97c \uc798\uac8c \ub098\ub204\uc790\uace0 \uc81c\uc548\ud55c\ub2e4.","input":"\ubaa8\ub974\uaca0\uc5b4","thinking":"\ub9c9\ud798\uc740 \uc124\uba85\ubcf4\ub2e4 \ubd84\ud574\uac00 \uba3c\uc800\ub2e4.","response":"\uad1c\ucc2e\uc544. \uc9c0\uae08 \ub9c9\ud788\ub294 \ubd80\ubd84\uc744 \ud55c \ubb38\uc7a5\uc73c\ub85c \ub9d0\ud574\uc8fc\uba74 \uac70\uae30\uc11c\ubd80\ud130 \ub2e4\uc2dc \ud480\uc5b4\uc904\uac8c.","tags":["reasoning","repair","followup"],"language":"ko","reward_weight":18}
{"instruction":"\ud55c \uc904 \ub2f5\ubcc0 \uc694\uccad\uc5d0\ub294 \ud615\uc2dd\uc744 \ub9de\ucd98\ub2e4.","input":"\ud55c \uc904\ub85c \ub2f5\ud574\uc918","thinking":"\ud615\uc2dd \uc81c\uc57d\uc740 \ubc14\ub85c \ubc18\uc601\ud55c\ub2e4.","response":"\uc54c\uaca0\uc5b4. \ud55c \uc904\ub85c \uc555\ucd95\ud574\uc11c \ub2f5\ud560\uac8c.","tags":["reasoning","style","direct-answer"],"language":"ko","reward_weight":18}
{"instruction":"\uc65c\ub77c\ub294 \uc9c8\ubb38\uc5d0\ub294 \uc6d0\uc778 \uc911\uc2ec\uc73c\ub85c \uc9e7\uac8c \uc124\uba85\ud55c\ub2e4.","input":"\uc65c \ud558\ub298\uc774 \ud30c\ub797\uac8c \ubcf4\uc5ec?","thinking":"\ud604\uc0c1 \uc9c8\ubb38\uc740 \ud575\uc2ec \uc6d0\uc778 \ud55c \uc904\ubd80\ud130 \uc900\ub2e4.","response":"\ud587\ube5b\uc774 \ub300\uae30\ub97c \uc9c0\ub098\uba74\uc11c \uc9e7\uc740 \ud30c\uc7a5\uc758 \ud478\ub978\ube5b\uc774 \ub354 \uc798 \uc0b0\ub780\ub418\uae30 \ub54c\ubb38\uc774\uc57c.","tags":["reasoning","definition","science"],"language":"ko","reward_weight":20}
{"instruction":"\ub2e4\uc74c \uc9c8\ubb38\ub3c4 \ub9cc\ub4e4\uc5b4\ub2ec\ub77c\uace0 \ud558\uba74 \ud6c4\uc18d \uc9c8\ubb38\uc744 \ubd99\uc774\uaca0\ub2e4\uace0 \ub2f5\ud55c\ub2e4.","input":"\ub2e4\uc74c \uc9c8\ubb38\ub3c4 \ub9cc\ub4e4\uc5b4\uc918","thinking":"\uc0ac\uc6a9\uc790\ub294 \ub2f5\ubcc0 \ub4a4\uc5d0 \uc774\uc5b4\uc9c8 \uc9c8\ubb38\uae4c\uc9c0 \uc6d0\ud55c\ub2e4.","response":"\uc88b\uc544. \uba3c\uc800 \ub2f5\uc744 \uc815\ub9ac\ud558\uace0, \uc774\uc5b4\uc11c \uc0dd\uac01\ud574\ubcfc \ub2e4\uc74c \uc9c8\ubb38\ub3c4 \uac19\uc774 \ubd99\uc5ec\uc904\uac8c.","tags":["reasoning","followup","planning"],"language":"ko","reward_weight":18}


